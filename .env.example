# Database + cross-device progress.
#
# 1. Create a free project at https://supabase.com.
# 2. Run supabase/schema.sql in the Supabase SQL editor.
# 3. Fill the two values below in .env.local, then restart the app.
#
# Use the public anon key only. Never put a service_role key in a
# NEXT_PUBLIC_ variable: every browser would receive it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used for metadata, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
