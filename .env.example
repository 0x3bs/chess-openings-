# Accounts + cross-device progress sync.
# Copy this file to .env.local, fill both values, then restart the dev server.
# Leave them empty to keep progress local to one browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: production URL used in Supabase email confirmation links.
# Add the same URL under Authentication -> URL Configuration in Supabase.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
