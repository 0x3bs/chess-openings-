{
  "name": "chess-coach",
  "version": "0.1.0",
  "private": true,
  "description": "A bilingual (English/Arabic) chess opening trainer with one idea for every move.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "validate": "tsx scripts/validate-lines.ts",
    "i18n:check": "tsx scripts/check-i18n.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run validate && npm run i18n:check && npm run typecheck",
    "audit": "tsx scripts/audit-lines.ts",
    "generate": "tsx scripts/generate-lines.ts"
  },
  "dependencies": {
    "@lichess-org/chessground": "^10.5.0",
    "chess.js": "1.4.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "stockfish": "^19.0.1",
    "tsx": "4.23.15",
    "typescript": "^5.9.0"
  }
}
